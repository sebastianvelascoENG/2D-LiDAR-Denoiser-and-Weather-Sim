Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.6
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Name: scan_clean
      Enabled: false
      Topic:
        Value: /scan_clean
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Color: 130; 130; 130
      Color Transformer: FlatColor
      Style: Points
    - Class: rviz_default_plugins/LaserScan
      Name: scan (rain)
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (Pixels): 3
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Style: Points
    - Class: rviz_default_plugins/LaserScan
      Name: scan_denoised
      Enabled: true
      Topic:
        Value: /scan_denoised
        Reliability Policy: Best Effort
      Size (Pixels): 4
      Color: 25; 255; 100
      Color Transformer: FlatColor
      Style: Points
    - Class: rviz_default_plugins/Odometry
      Name: ground_truth
      Enabled: true
      Topic:
        Value: /ground_truth
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 85; 0
        Shaft Length: 0.4
        Head Length: 0.15
    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 0; 170; 255
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 20
      Pitch: 1.0
      Yaw: 0.785
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
