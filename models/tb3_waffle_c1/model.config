<?xml version="1.0"?>
<model>
  <name>tb3_waffle_c1</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Sebastian V</name>
  </author>
  <description>
    TurtleBot3 Waffle with its 2D LiDAR retuned to approximate an RPLiDAR C1
    (500 samples/rev = 0.72 deg, 12 m max range, 10 Hz). Publishes the clean
    scan on gz topic "scan_clean"; the weather_model_node adds weather noise and
    republishes on /scan. Includes a ground-truth odometry publisher.
  </description>
</model>
